{
  "get": {
    "summary": "Latest unregistered-host sweep report",
    "parameters": [
      {
        "name": "sample",
        "in": "query",
        "required": false,
        "description": "Set to 1 to serve the step's bundled sample.json fixture instead of the stored sweep, for demos and UI work. Opt-in only — it is never used as a fallback when no sweep has run.",
        "schema": { "type": "string", "enum": ["1"] }
      }
    ],
    "responses": {
      "200": {
        "description": "The most recent nightly sweep",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["generated_at", "window", "source", "unmanaged", "unsupported"],
              "properties": {
                "generated_at": { "type": "string", "format": "date-time" },
                "window": { "type": "string" },
                "source": { "type": "string" },
                "managed_hosts_compared": { "type": "integer" },
                "unmanaged": { "type": "array", "items": { "type": "object", "properties": {
                  "id": { "type": "string" },
                  "entity_type": { "type": "string" },
                  "hostname": { "type": "string" },
                  "current_local_ip": { "type": "string" },
                  "mac_address": { "type": "string" },
                  "os_version": { "type": "string" },
                  "platform_name": { "type": "string" },
                  "confidence": { "type": "integer" },
                  "first_seen": { "type": "string" },
                  "last_seen": { "type": "string" },
                  "discovered_by": { "type": "string" },
                  "discoverer_tags": { "type": "array", "items": { "type": "string" } },
                  "matches_managed_host": { "type": "boolean" }
                } } },
                "unsupported": { "type": "array", "items": { "type": "object" } }
              }
            }
          }
        }
      },
      "404": {
        "description": "No sweep has run yet, or sample=1 was requested and sample.json is absent",
        "content": {
          "application/json": {
            "schema": { "type": "object", "properties": { "error": { "type": "string" } } }
          }
        }
      }
    }
  }
}
